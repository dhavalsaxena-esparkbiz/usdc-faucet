# EVM network RPC (e.g. Sepolia, Base Sepolia, local Anvil)
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Must match the chain your dummy USDC is deployed on
CHAIN_ID=11155111

# Your dummy USDC ERC-20 contract address
USDC_CONTRACT_ADDRESS=0xb488571cad90C75a60C5CC533c1a8E0b0F7B50f3

# Faucet wallet — holds USDC to send via transfer(); needs native gas for txs
# With or without 0x prefix (64 hex chars)
FAUCET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Amount sent per drip (human-readable, e.g. 100 = 100 USDC)
DRIP_AMOUNT=1000

# Token decimals (USDC is usually 6)
DRIP_DECIMALS=6

# Hours between drips per wallet address
COOLDOWN_HOURS=24

# Server
PORT=3000

# Comma-separated allowed browser origins (use * only for local dev)
CORS_ORIGIN=http://localhost:5173

# Optional: public URL of the API when frontend is hosted separately
# VITE_API_URL=https://your-api.onrender.com
